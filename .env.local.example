# ---- Grok (xAI) : realtime voice + TTS ----
XAI_API_KEY=
# Optional overrides if the realtime surface differs from the default
XAI_BASE_URL=https://api.x.ai/v1
XAI_VOICE_MODEL=grok-voice-latest
XAI_TTS_VOICE=eve

# ---- IFM K2 Horizon : commander reasoning ----
IFM_API_KEY=
IFM_BASE_URL=
IFM_MODEL=IFM/K2-Horizon-375B-A23B

# ---- Optional: local K2 small model for OFFLINE mode (GPU box) ----
# Leave BLANK for tier-1 offline (deterministic, zero deps) - recommended.
# Tier 2, TESTED WORKING on this laptop, if you want an LLM reasoning offline:
#   LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
#   LOCAL_MODEL_NAME=llama3.1:8b
# K2-Horizon-0.9B-GGUF does NOT load in ollama 0.31.1 (unknown arch 'k2-horizon').
# See docs/API-NOTES.md.
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=llama3.1:8b

# ---- Mapbox : AED routing + ETA ----
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---- Supabase : cross-device multiplayer ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
